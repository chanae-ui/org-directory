# העתיקי קובץ זה ל-.env ומלאי את הערכים האמיתיים. קובץ .env לא נכנס ל-git.

# מפתח ה-API של Monday: Monday -> תמונת פרופיל -> Admin -> API -> Generate token
MONDAY_API_TOKEN=

# רשימת ה-Boards שמסנכרנים (Board ID + מיפוי עמודות) מוגדרת בקובץ src/sync/boardsConfig.js

# מחרוזת חיבור למסד הנתונים
DATABASE_URL=postgresql://user:password@localhost:5432/org_directory

# פורט לשרת ה-API
PORT=3001
